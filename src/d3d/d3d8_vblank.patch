+// The library's vertical blank interrupt, which nothing stood in for on this host. On the console the miniport
+// counts blanks at CDevice+0x1DE8 (XDK 5849: the handler 0x4A2FD1 increments it), signals the notification event at
+// +0x1DBC and calls the title's callback stored at +0x1DB8. D3DDevice_GetRasterStatus (0x003BA010 in this image)
+// returns that count, and the XMV decoder paces its frames by it: with the count stuck at 0 it shows its first
+// frame and never a second. Same as the SDK's own d3d8.cpp, which runs this on a host thread at 60 Hz.
+constexpr uint32_t kVBlankCountOff = 0x1DE8, kVBlankEventOff = 0x1DBC, kVBlankCallbackOff = 0x1DB8;
+
+void VerticalBlank(X86Context& ctx) {
+    using clock = std::chrono::steady_clock;
+    uint32_t info = mem::AllocSystem(12), shown = 0;
+    auto next = clock::now();
+    for (;;) {
+        next = std::max(next + std::chrono::microseconds(16667), clock::now());
+        std::this_thread::sleep_until(next);
+        uint32_t count = Dev(kVBlankCountOff) + 1, swaps = Dev(kDevSwapCount);
+        SetDev(kVBlankCountOff, count);
+        ObjectRef event = FromPointer(kDevice + kVBlankEventOff);
+        SetEvent(*event);
+        if (uint32_t callback = Dev(kVBlankCallbackOff)) {
+            // blank count, swaps shown, 1 when this blank showed one
+            W32(info, count);
+            W32(info + 4, swaps);
+            W32(info + 8, swaps != shown);
+            CallGuest(ctx, callback, {info});
+        }
+        shown = swaps;
+        // the title clears the event in its own memory before a wait, which the host object does not see
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        ResetEvent(*event);
+    }
+}
+
 }  // namespace
 
