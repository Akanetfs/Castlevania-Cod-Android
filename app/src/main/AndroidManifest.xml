<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.codandroid.recomp"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x400003" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- sin acceso a todos los archivos: el .iso se abre por su URI (selector de Android), las carpetas se copian a la app y la copia de saves usa una carpeta elegida con el selector -->

    <application
        android:name="launcher.CodApp"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Castlevania CoD"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault" >

        <!-- el launcher: lo que abre el icono -->
        <activity
            android:name="launcher.LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- el juego: ya sin intent-filter, lo abre el launcher -->
        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>

</manifest>